<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-100 text-gray-800">
    <%- include('../partials/navbar') %>

    <main class="mx-auto w-11/12 max-w-5xl py-10">
      <a
        href="/houses"
        class="text-sm font-semibold text-gray-600 hover:text-red-500"
        >← Back to houses</a
      >

      <div class="mt-5 overflow-hidden rounded-3xl bg-white shadow-lg">
        <% if (house.photoUrl) { %>
        <img
          src="<%= house.photoUrl %>"
          alt="<%= house.houseName %>"
          class="h-72 w-full object-cover sm:h-96"
        />
        <% } else { %>
        <div
          class="flex h-72 items-center justify-center bg-gray-200 text-gray-500 sm:h-96"
        >
          No photo available
        </div>
        <% } %>

        <div class="p-6 sm:p-8">
          <div
            class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between"
          >
            <div>
              <p
                class="text-sm font-semibold uppercase tracking-widest text-red-500"
              >
                House Details
              </p>
              <h1 class="mt-1 text-3xl font-bold text-gray-900 sm:text-4xl">
                <%= house.houseName %>
              </h1>
              <p class="mt-2 text-gray-500">📍 <%= house.location %></p>
            </div>
            <div class="rounded-xl bg-green-50 px-4 py-3 text-center">
              <p class="text-xs font-medium text-gray-500">Rating</p>
              <p class="mt-1 text-lg font-bold text-green-600">
                ★ <%= house.rating %>
              </p>
            </div>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5">
              <p class="text-sm text-gray-500">Price per night</p>
              <p class="mt-1 text-2xl font-bold text-gray-900">
                ₹<%= house.price %>
              </p>
            </div>
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5">
              <p class="text-sm text-gray-500">Location</p>
              <p class="mt-1 text-lg font-semibold text-gray-900">
                <%= house.location %>
              </p>
            </div>
          </div>

          <div class="mt-8 rounded-2xl bg-gray-50 p-5">
            <h2 class="text-lg font-bold text-gray-900">About this stay</h2>
            <p class="mt-2 leading-7 text-gray-600">
              Enjoy a comfortable stay at <%= house.houseName %>. Check the
              details above and continue when you are ready.
            </p>
          </div>
        </div>

        <%- include('../partials/favourite') %>
      </div>
    </main>
  </body>

</html>
