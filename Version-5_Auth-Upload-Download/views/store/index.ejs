<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-100 text-gray-800">
    <%- include('../partials/navbar') %>

    <header class="bg-white px-4 py-14 text-center shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-widest text-rose-500">
        Stay somewhere you love
      </p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">Welcome to airbnb</h1>
      <p class="mx-auto mt-3 max-w-xl text-gray-500">
        Find comfortable homes, beautiful places and memorable stays.
      </p>

      <% if (isLoggedIn && user && user.userType === 'host') { %>
      <a
        href="/host/host-houses-list"
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-rose-500 px-6 py-3 font-semibold text-white shadow-md transition hover:bg-rose-600 hover:shadow-lg active:scale-95"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
        Manage Your Houses
      </a>
      <% } else { %>
      <a
        href="/houses"
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-rose-500 px-6 py-3 font-semibold text-white shadow-md transition hover:bg-rose-600 hover:shadow-lg active:scale-95"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        Explore Houses
      </a>
      <% } %>
    </header>

    <main class="mx-auto w-11/12 max-w-6xl py-10">
      <div class="mb-7 flex items-end justify-between">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Available Houses</h2>
          <p class="mt-1 text-sm text-gray-500">
            Browse the latest homes added by hosts. Click "View Details" to see full descriptions and rules.
          </p>
        </div>
      </div>

      <% if (registeredHouses.length === 0) { %>
      <div class="rounded-2xl bg-white p-10 text-center shadow-sm">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-rose-50 text-rose-500">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
        </div>
        <p class="mt-4 text-gray-500">No houses registered yet.</p>
        <a
          href="/host/add-house"
          class="mt-5 inline-block rounded-lg bg-rose-500 px-6 py-2.5 font-semibold text-white shadow-sm transition hover:bg-rose-600"
          >Add House</a
        >
      </div>
      <% } else { %>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% registeredHouses.forEach(house => { %>
        <article
          class="group overflow-hidden rounded-2xl bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-xl flex flex-col justify-between"
        >
          <div>
            <div class="relative">
              <% if (house.photo) { %>
              <img
                src="<%= house.photo %>"
                alt="<%= house.houseName %>"
                class="h-56 w-full object-cover transition-transform duration-300 group-hover:scale-102"
              />
              <% } else { %>
              <div
                class="flex h-56 flex-col items-center justify-center bg-gray-100 text-gray-400"
              >
                <svg class="mb-1 h-10 w-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span class="text-xs font-medium">No photo available</span>
              </div>
              <% } %>

              <!-- Favourite heart icon on top right: ONLY shown for guest/visitor, NEVER for host -->
              <% if (!user || user.userType !== 'host') { %>
              <div class="absolute top-3 right-3 z-10">
                <%- include('../partials/favourite', { house: house, variant: 'icon' }) %>
              </div>
              <% } %>
            </div>

            <div class="p-5">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="truncate text-lg font-bold text-gray-900 group-hover:text-rose-600 transition">
                    <%= house.houseName %>
                  </h3>
                  <p class="mt-1 flex items-center gap-1 text-sm text-gray-500">
                    <svg class="h-3.5 w-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="truncate"><%= house.location %></span>
                  </p>
                  <% if (house.host && house.host.firstName) { %>
                  <p class="mt-1 text-xs text-gray-400 truncate">
                    Hosted by <span class="font-medium text-gray-600"><%= house.host.firstName %></span>
                  </p>
                  <% } %>
                </div>
                <span
                  class="shrink-0 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700"
                >
                  <svg class="h-3 w-3 fill-emerald-600" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <%= house.rating %>
                </span>
              </div>
            </div>
          </div>

          <div class="p-5 pt-0">
            <div class="flex items-center justify-between border-t border-gray-100 pt-4">
              <span class="font-bold text-gray-900"
                >₹<%= house.price %>
                <span class="text-xs font-normal text-gray-500">/ night</span>
              </span>
              <a
                href="/houses/<%= house._id %>"
                class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3.5 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:border-rose-500 hover:bg-rose-50 hover:text-rose-600"
              >
                <span>View Details</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </main>
  </body>
</html>
