<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-100 text-gray-800">
    <%- include('../partials/navbar') %>

    <main class="mx-auto flex min-h-[calc(100vh-140px)] w-11/12 max-w-xl items-center justify-center py-12">
      <div class="w-full overflow-hidden rounded-3xl border border-gray-100 bg-white p-8 sm:p-10 text-center shadow-xl">
        <!-- Badge Icon -->
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-rose-50 text-rose-500 shadow-sm">
          <!-- Custom Logo combined with key/compass element -->
          <svg class="h-10 w-10 text-rose-500" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 2.5L3 13.5V26.5C3 27.6 3.9 28.5 5 28.5H27C28.1 28.5 29 27.6 29 26.5V13.5L16 2.5Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M11.5 28.5V17.5C11.5 16.4 12.4 15.5 13.5 15.5H18.5C19.6 15.5 20.5 16.4 20.5 17.5V28.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 8C14.9 8 14 8.9 14 10C14 11.5 16 13 16 13C16 13 18 11.5 18 10C18 8.9 17.1 8 16 8Z" fill="currentColor"/>
          </svg>
        </div>

        <span class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-rose-600">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          Guest Authentication Required
        </span>

        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          Log in to Explore Houses
        </h1>
        <p class="mx-auto mt-3 max-w-md text-sm text-gray-500 leading-relaxed">
          Please log in or sign up to explore our complete collection of homes, view house details, download house rules, and save your favourite stays.
        </p>

        <!-- Feature Benefits -->
        <div class="my-6 rounded-2xl border border-gray-100 bg-gray-50/70 p-4 text-left">
          <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2.5">What you get as a guest:</p>
          <ul class="space-y-2 text-xs text-gray-600">
            <li class="flex items-center gap-2">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold">✓</span>
              Browse dozens of registered stays with real-time pricing and ratings
            </li>
            <li class="flex items-center gap-2">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold">✓</span>
              Save places to your personal wishlists and favourites
            </li>
            <li class="flex items-center gap-2">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold">✓</span>
              Inspect full house guidelines and download official PDF rules
            </li>
          </ul>
        </div>

        <!-- Action Buttons -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href="/login"
            class="flex items-center justify-center gap-2 rounded-xl bg-rose-500 py-3.5 px-5 text-sm font-semibold text-white shadow-md transition hover:bg-rose-600 hover:shadow-lg active:scale-98"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            <span>Log In</span>
          </a>

          <a
            href="/signup"
            class="flex items-center justify-center gap-2 rounded-xl border-2 border-rose-500 bg-white py-3.5 px-5 text-sm font-semibold text-rose-600 transition hover:bg-rose-50 active:scale-98"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            <span>Sign Up</span>
          </a>
        </div>

        <div class="mt-6 border-t border-gray-100 pt-5">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500 hover:text-gray-900 transition"
          >
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Home Page
          </a>
        </div>
      </div>
    </main>
  </body>
</html>

