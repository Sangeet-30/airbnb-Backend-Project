<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-100 text-gray-800">
    <%- include('../partials/navbar') %>

    <header class="bg-white px-4 py-10 text-center shadow-sm">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-rose-50 text-rose-500 mb-2">
        <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">My Favourites</h1>
      <p class="mt-2 text-gray-500">Your curated collection of places to stay.</p>
    </header>

    <main class="mx-auto w-11/12 max-w-6xl py-10">
      <% if (favouriteHouses.length === 0) { %>
      <div class="rounded-2xl bg-white p-10 text-center shadow-sm">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-rose-50 text-rose-400">
          <svg class="h-7 w-7 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-bold text-gray-800">No favourites saved yet</h3>
        <p class="mt-1 text-sm text-gray-500">Explore places and tap the heart icon to save your favourites.</p>
        <a
          href="/houses"
          class="mt-6 inline-flex items-center gap-2 rounded-xl bg-rose-500 px-6 py-2.5 font-semibold text-white shadow-sm transition hover:bg-rose-600 active:scale-95"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Browse Houses
        </a>
      </div>
      <% } else { %>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% favouriteHouses.forEach(house => { %>
        <article class="group overflow-hidden rounded-2xl bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-xl flex flex-col justify-between">
          <div>
            <div class="relative">
              <% if (house.photo) { %>
              <img
                src="<%= house.photo %>"
                alt="<%= house.houseName %>"
                class="h-56 w-full object-cover transition-transform duration-300 group-hover:scale-102"
              />
              <% } else { %>
              <div
                class="flex h-56 flex-col items-center justify-center bg-gray-100 text-gray-400"
              >
                <svg class="mb-1 h-10 w-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span class="text-xs font-medium">No photo available</span>
              </div>
              <% } %>

              <!-- Remove icon button overlay -->
              <form action="/favourites/delete/<%= house._id %>" method="POST" class="absolute top-3 right-3 z-10 m-0">
                <button
                  type="submit"
                  title="Remove from Favourites"
                  class="flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-rose-500 shadow-md backdrop-blur-sm transition hover:scale-110 hover:bg-white active:scale-95 cursor-pointer"
                >
                  <svg class="h-5 w-5 fill-rose-500" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                </button>
              </form>
            </div>

            <div class="p-5">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="truncate text-lg font-bold text-gray-900 group-hover:text-rose-600 transition"><%= house.houseName %></h3>
                  <p class="mt-1 flex items-center gap-1 text-sm text-gray-500">
                    <svg class="h-3.5 w-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="truncate"><%= house.location %></span>
                  </p>
                </div>
                <span
                  class="shrink-0 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700"
                >
                  <svg class="h-3 w-3 fill-emerald-600" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <%= house.rating %>
                </span>
              </div>
            </div>
          </div>

          <div class="p-5 pt-0">
            <div class="flex items-center justify-between border-t border-gray-100 pt-4">
              <span class="font-bold text-gray-900"
                >₹<%= house.price %>
                <span class="text-xs font-normal text-gray-500">/ night</span>
              </span>

              <div class="flex items-center gap-2">
                <a
                  href="/houses/<%= house._id %>"
                  class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 transition hover:border-rose-300 hover:bg-rose-50 hover:text-rose-600"
                >
                  Details
                </a>

                <a
                  href="/bookings%>"
                  class="rounded-lg bg-rose-500 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-rose-600 active:scale-95"
                >
                  Book
                </a>
              </div>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </main>
  </body>
</html>
