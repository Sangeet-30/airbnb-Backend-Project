<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-100 text-gray-800">
    <%- include('../partials/navbar') %>

    <main class="mx-auto w-11/12 max-w-5xl py-8">
      <div class="mb-5 flex items-center justify-between">
        <% if (isLoggedIn && user && user.userType === 'host') { %>
        <a
          href="/host/host-houses-list"
          class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:border-gray-300 hover:bg-gray-50 hover:text-rose-600"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to host houses
        </a>
        <% } else { %>
        <a
          href="/houses"
          class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:border-gray-300 hover:bg-gray-50 hover:text-rose-600"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to houses
        </a>
        <% } %>

        <!-- Favourite Action Button in Header: ONLY for guests, NEVER for hosts -->
        <% if (!user || user.userType !== 'host') { %>
        <div>
          <%- include('../partials/favourite', { house: house }) %>
        </div>
        <% } %>
      </div>

      <div class="overflow-hidden rounded-3xl bg-white shadow-md">
        <div class="relative">
          <% if (house.photo) { %>
          <img
            src="<%= house.photo %>"
            alt="<%= house.houseName %>"
            class="h-72 w-full object-cover sm:h-96 md:h-112"
          />
          <% } else { %>
          <div
            class="flex h-72 flex-col items-center justify-center bg-gray-100 text-gray-400 sm:h-96"
          >
            <svg class="mb-2 h-14 w-14 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <p class="text-sm font-medium">No photo available</p>
          </div>
          <% } %>

          <!-- Floating favourite button on hero image: NEVER for hosts -->
          <% if (!user || user.userType !== 'host') { %>
          <div class="absolute top-4 right-4 z-10">
            <%- include('../partials/favourite', { house: house, variant: 'icon' }) %>
          </div>
          <% } %>
        </div>

        <div class="p-6 sm:p-10">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between border-b border-gray-100 pb-6">
            <div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-3 py-1 text-xs font-bold tracking-wider uppercase text-rose-600">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                House Details
              </span>
              <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                <%= house.houseName %>
              </h1>
              <p class="mt-2 flex items-center gap-1.5 text-base text-gray-500">
                <svg class="h-4 w-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <%= house.location %>
              </p>
            </div>
            <div class="shrink-0 flex items-center gap-3 rounded-2xl bg-emerald-50 px-5 py-3 border border-emerald-100">
              <svg class="h-7 w-7 fill-emerald-600" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-emerald-800">Rating</p>
                <p class="text-2xl font-black text-emerald-700">
                  <%= house.rating %> <span class="text-xs font-normal text-emerald-600">/ 5</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Highlight Cards -->
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-gray-100 bg-gray-50/70 p-5 transition hover:border-gray-200">
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Price per night</p>
              <p class="mt-1 text-2xl font-black text-gray-900">
                ₹<%= house.price %>
                <span class="text-sm font-normal text-gray-500">total before taxes</span>
              </p>
            </div>
            <div class="rounded-2xl border border-gray-100 bg-gray-50/70 p-5 transition hover:border-gray-200">
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Location</p>
              <p class="mt-1 text-lg font-bold text-gray-900">
                <%= house.location %>
              </p>
            </div>
          </div>

          <!-- Host Information Card -->
          <div class="mt-8 flex items-center justify-between gap-4 rounded-2xl border border-gray-200 bg-gray-50/70 p-5 shadow-sm">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-rose-500 font-bold text-white shadow-sm text-lg">
                <%= (house.host && house.host.firstName) ? house.host.firstName[0].toUpperCase() : 'H' %>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-wider text-rose-600">Hosted by</p>
                <h3 class="truncate text-base font-bold text-gray-900">
                  <%= (house.host && house.host.firstName) ? (house.host.firstName + ' ' + (house.host.lastName || '')).trim() : 'Verified Host' %>
                </h3>
                <p class="text-xs text-gray-500 truncate">Registered host on airbnb</p>
              </div>
            </div>
            <span class="shrink-0 inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-xs font-semibold text-gray-700 border border-gray-200 shadow-sm">
              <svg class="h-3.5 w-3.5 text-rose-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Verified Host
            </span>
          </div>

          <!-- Description Section (Detailed view exclusive) -->
          <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="flex items-center gap-2.5 text-xl font-bold text-gray-900">
              <svg class="h-6 w-6 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              About this place
            </h2>
            <div class="mt-4 border-t border-gray-100 pt-4">
              <p class="leading-relaxed text-gray-700 whitespace-pre-line text-base">
                <% if (house.description && house.description.trim()) { %>
                  <%= house.description %>
                <% } else { %>
                  Enjoy a comfortable and memorable stay at <strong class="text-gray-900"><%= house.houseName %></strong> located in the heart of <%= house.location %>. Check the rules and amenities and reserve whenever you are ready!
                <% } %>
              </p>
            </div>
          </div>

          <!-- House Rules Document Download -->
          <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-2xl border border-blue-100 bg-blue-50/70 p-5">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-900">House Rules & Guidelines</p>
                <p class="text-xs text-gray-500">Read important instructions before booking</p>
              </div>
            </div>

            <a
              href="/rules/<%= house._id || house.id %>"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 active:scale-95"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
              </svg>
              Download PDF
            </a>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
