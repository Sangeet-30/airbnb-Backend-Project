<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-100 text-gray-800">
    <%- include('../partials/navbar') %>

    <header class="bg-white px-4 py-10 text-center shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-widest text-rose-500">
        Host Dashboard
      </p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">Host Houses List</h1>
      <p class="mt-2 text-gray-500">Manage and preview the properties you have registered.</p>
    </header>

    <main class="mx-auto w-11/12 max-w-6xl py-10">
      <% if (registeredHouses.length === 0) { %>
      <div class="rounded-2xl bg-white p-10 text-center shadow-sm">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-rose-50 text-rose-500">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
        </div>
        <p class="mt-4 text-gray-500">No houses registered under your account yet.</p>
        <a
          href="/host/add-house"
          class="mt-5 inline-block rounded-lg bg-rose-500 px-6 py-2.5 font-semibold text-white shadow-sm transition hover:bg-rose-600"
          >Add New House</a
        >
      </div>
      <% } else { %>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% registeredHouses.forEach(house => { %>
        <article
          class="group overflow-hidden rounded-2xl bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-xl flex flex-col justify-between"
        >
          <div>
            <div class="relative">
              <% if (house.photo) { %>
              <img
                src="<%= house.photo %>"
                alt="<%= house.houseName %>"
                class="h-52 w-full object-cover transition-transform duration-300 group-hover:scale-102"
              />
              <% } else { %>
              <div
                class="flex h-52 flex-col items-center justify-center bg-gray-100 text-gray-400"
              >
                <svg class="mb-1 h-10 w-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span class="text-xs font-medium">No photo available</span>
              </div>
              <% } %>
            </div>

            <div class="p-5">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="truncate text-lg font-bold text-gray-900 group-hover:text-rose-600 transition"><%= house.houseName %></h3>
                  <p class="mt-1 flex items-center gap-1 text-sm text-gray-500">
                    <svg class="h-3.5 w-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="truncate"><%= house.location %></span>
                  </p>
                </div>
                <span
                  class="shrink-0 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700"
                >
                  ★ <%= house.rating %>
                </span>
              </div>
            </div>
          </div>

          <div class="p-5 pt-0">
            <div class="flex items-center justify-between border-t border-gray-100 pt-4">
              <span class="font-bold text-gray-900"
                >₹<%= house.price %>
                <span class="text-xs font-normal text-gray-500">/ night</span>
              </span>

              <div class="flex items-center gap-2">
                <a
                  href="/houses/<%= house._id %>"
                  class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 transition hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900"
                  title="View Details"
                >
                  View Details
                </a>
                <a
                  href="/host/edit-house/<%= house._id %>?editing=true"
                  class="rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-blue-700 active:scale-95"
                >
                  Edit
                </a>
                <form action="/host/delete-house/<%= house._id %>" method="POST" class="m-0">
                  <button
                    type="submit"
                    class="rounded-lg bg-red-500 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-red-600 active:scale-95 cursor-pointer"
                  >
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </main>
  </body>
</html>
