<%- include('../partials/head') %>
  </head>
<body class="min-h-screen bg-gray-100 text-gray-800">
  <%- include('../partials/navbar') %>

  <main class="mx-auto flex min-h-[calc(100vh-80px)] w-11/12 max-w-lg items-center justify-center py-12">
    <div class="w-full overflow-hidden rounded-3xl bg-white shadow-xl border border-gray-100">
      <!-- Card Header -->
      <div class="border-b border-gray-100 bg-linear-to-b from-rose-50/50 to-white px-8 pt-8 pb-6 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-50 text-rose-500 shadow-sm">
          <!-- Custom original logo mark -->
          <svg class="h-8 w-8 text-rose-500" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 2.5L3 13.5V26.5C3 27.6 3.9 28.5 5 28.5H27C28.1 28.5 29 27.6 29 26.5V13.5L16 2.5Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M11.5 28.5V17.5C11.5 16.4 12.4 15.5 13.5 15.5H18.5C19.6 15.5 20.5 16.4 20.5 17.5V28.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 8C14.9 8 14 8.9 14 10C14 11.5 16 13 16 13C16 13 18 11.5 18 10C18 8.9 17.1 8 16 8Z" fill="currentColor"/>
          </svg>
        </div>
        <h1 class="mt-4 text-2xl font-bold tracking-tight text-gray-900">Create your airbnb Account</h1>
        <p class="mt-1 text-sm text-gray-500">Join our global community of hosts and travellers</p>
      </div>

      <%- include('../partials/errors') %>

      <!-- Form Body -->
      <form action="/signup" method="POST" class="grid gap-4.5 p-8 pt-6">
        <!-- First & Last Name row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="firstName" class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-gray-600">
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              First Name
            </label>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <input
                id="firstName"
                type="text"
                name="firstName"
                value="<%= oldInput && oldInput.firstName ? oldInput.firstName : '' %>"
                placeholder="First name"
                class="w-full rounded-xl border border-gray-300 py-2.5 pr-3 pl-10 text-sm transition outline-none focus:border-rose-500 focus:ring-3 focus:ring-rose-100"
                required
              />
            </div>
          </div>

          <div>
            <label for="lastName" class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-gray-600">
              Last Name
            </label>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <input
                id="lastName"
                type="text"
                name="lastName"
                value="<%= oldInput && oldInput.lastName ? oldInput.lastName : '' %>"
                placeholder="Last name"
                class="w-full rounded-xl border border-gray-300 py-2.5 pr-3 pl-10 text-sm transition outline-none focus:border-rose-500 focus:ring-3 focus:ring-rose-100"
              />
            </div>
          </div>
        </div>

        <!-- Email Address -->
        <div>
          <label for="email" class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-gray-600">
            <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
            </svg>
            Email Address
          </label>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <input
              id="email"
              type="email"
              name="email"
              value="<%= oldInput && oldInput.email ? oldInput.email : '' %>"
              placeholder="you@example.com"
              class="w-full rounded-xl border border-gray-300 py-2.5 pr-3 pl-10 text-sm transition outline-none focus:border-rose-500 focus:ring-3 focus:ring-rose-100"
              required
            />
          </div>
        </div>

        <!-- Password -->
        <div>
          <label for="password" class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-gray-600">
            <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Password
          </label>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
              </svg>
            </div>
            <input
              id="password"
              type="password"
              name="password"
              placeholder="Min. 8 chars with uppercase, number & symbol"
              class="w-full rounded-xl border border-gray-300 py-2.5 pr-10 pl-10 text-sm transition outline-none focus:border-rose-500 focus:ring-3 focus:ring-rose-100"
              required
            />
            <button
              type="button"
              id="toggle-signup-password"
              aria-label="Toggle password visibility"
              class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 transition hover:text-gray-600 cursor-pointer"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Confirm Password -->
        <div>
          <label for="confirmPassword" class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-gray-600">
            <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            Confirm Password
          </label>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
              </svg>
            </div>
            <input
              id="confirmPassword"
              type="password"
              name="confirmPassword"
              placeholder="Confirm your password"
              class="w-full rounded-xl border border-gray-300 py-2.5 pr-3 pl-10 text-sm transition outline-none focus:border-rose-500 focus:ring-3 focus:ring-rose-100"
              required
            />
          </div>
        </div>

        <!-- User Type Dropdown Selector with Icons -->
        <div>
          <label for="userType" class="mb-1.5 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-gray-600">
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
              I want to join as (User Type)
            </span>
          </label>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
              <svg class="h-4 w-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
            <select
              id="userType"
              name="userType"
              required
              class="w-full appearance-none rounded-xl border border-gray-300 bg-white py-2.5 pr-10 pl-10 text-sm font-medium text-gray-700 transition outline-none focus:border-rose-500 focus:ring-3 focus:ring-rose-100 cursor-pointer"
            >
              <option value="" disabled <%= !oldInput || !oldInput.userType ? 'selected' : '' %>>-- Select Role (Guest or Host) --</option>
              <option value="guest" <%= oldInput && oldInput.userType === 'guest' ? 'selected' : '' %>>🧳 Guest — Explore & Book Stays</option>
              <option value="host" <%= oldInput && oldInput.userType === 'host' ? 'selected' : '' %>>🏡 Host — Register & Host Properties</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Terms and conditions -->
        <div class="flex items-start gap-2.5 pt-1">
          <input
            id="terms"
            type="checkbox"
            name="terms"
            required
            class="h-4 w-4 mt-0.5 rounded border-gray-300 text-rose-500 focus:ring-rose-400 cursor-pointer"
          />
          <label for="terms" class="text-xs text-gray-600 cursor-pointer">
            I agree to the <span class="font-semibold text-gray-800">Terms of Service</span> and <span class="font-semibold text-gray-800">Privacy Policy</span>.
          </label>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl bg-rose-500 py-3.5 text-sm font-semibold text-white shadow-md transition hover:bg-rose-600 hover:shadow-lg active:scale-98 cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
          <span>Create Account</span>
        </button>

        <div class="mt-2 text-center text-xs text-gray-500">
          Already have an account?
          <a href="/login" class="font-semibold text-rose-500 hover:text-rose-600 hover:underline">
            Log in here
          </a>
        </div>
      </form>
    </div>
  </main>

  <script>
    (function () {
      const toggle = document.getElementById('toggle-signup-password');
      const input = document.getElementById('password');
      if (!toggle || !input) return;
      toggle.addEventListener('click', function () {
        const isPassword = input.getAttribute('type') === 'password';
        input.setAttribute('type', isPassword ? 'text' : 'password');
        toggle.innerHTML = isPassword
          ? '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>'
          : '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>';
      });
    })();
  </script>
</body>
</html>
