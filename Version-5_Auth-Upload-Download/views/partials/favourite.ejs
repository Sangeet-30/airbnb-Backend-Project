<%
  const isHost = (typeof user !== 'undefined' && user && user.userType === 'host');
%>
<% if (!isHost) { %>
  <%
    const houseIdStr = (house && (house._id || house.id)) ? (house._id || house.id).toString() : '';
    const isFav = (typeof isFavourite !== 'undefined' && isFavourite !== null)
      ? Boolean(isFavourite)
      : (typeof favouriteHouseIds !== 'undefined' && Array.isArray(favouriteHouseIds) && favouriteHouseIds.includes(houseIdStr));
    const isIcon = (typeof variant !== 'undefined' && variant === 'icon');
  %>
  <% if (isIcon) { %>
    <% if (isFav) { %>
      <form action="/favourites/delete/<%= houseIdStr %>" method="POST" class="inline-block m-0">
        <button
          type="submit"
          title="Remove from Favourites"
          aria-label="Remove from Favourites"
          class="group/fav flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-rose-500 shadow-md backdrop-blur-sm transition-all duration-200 hover:scale-110 hover:bg-white active:scale-90 cursor-pointer"
        >
          <svg
            class="h-5 w-5 fill-rose-500 text-rose-500 transition-transform duration-200 group-hover/fav:scale-110"
            viewBox="0 0 24 24"
          >
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </button>
      </form>
    <% } else { %>
      <form action="/favourites" method="POST" class="inline-block m-0">
        <input type="hidden" name="id" value="<%= houseIdStr %>" />
        <button
          type="submit"
          title="Add to Favourites"
          aria-label="Add to Favourites"
          class="group/fav flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-gray-600 shadow-md backdrop-blur-sm transition-all duration-200 hover:scale-110 hover:bg-white hover:text-rose-500 active:scale-90 cursor-pointer"
        >
          <svg
            class="h-5 w-5 fill-none stroke-current stroke-2 transition-colors duration-200 group-hover/fav:fill-rose-500 group-hover/fav:stroke-rose-500"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
            />
          </svg>
        </button>
      </form>
    <% } %>
  <% } else { %>
    <% if (isFav) { %>
      <form action="/favourites/delete/<%= houseIdStr %>" method="POST" class="inline-block m-0">
        <button
          type="submit"
          class="group inline-flex items-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-5 py-2.5 text-sm font-semibold text-rose-600 shadow-sm transition-all duration-200 hover:bg-rose-500 hover:text-white hover:border-rose-500 hover:shadow-md active:scale-95 cursor-pointer"
        >
          <svg class="h-4 w-4 fill-rose-500 transition-colors duration-200 group-hover:fill-white" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>Remove from Favourite</span>
        </button>
      </form>
    <% } else { %>
      <form action="/favourites" method="POST" class="inline-block m-0">
        <input type="hidden" name="id" value="<%= houseIdStr %>" />
        <button
          type="submit"
          class="group inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-5 py-2.5 text-sm font-semibold text-gray-700 shadow-sm transition-all duration-200 hover:border-rose-300 hover:bg-rose-50 hover:text-rose-600 hover:shadow-md active:scale-95 cursor-pointer"
        >
          <svg
            class="h-4 w-4 fill-none stroke-current stroke-2 transition-colors duration-200 group-hover:stroke-rose-600"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
            />
          </svg>
          <span>Add to Favourite</span>
        </button>
      </form>
    <% } %>
  <% } %>
<% } %>

