<% if (errors && errors.length > 0) { %>
<div
  class="mx-6 mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-red-800 shadow-sm"
  role="alert"
>
  <div class="flex items-start gap-3">
    <div class="shrink-0 text-red-500 mt-0.5">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>
    <div class="flex-1">
      <h3 class="text-sm font-bold text-red-900">Please review the following errors:</h3>
      <ul class="mt-1 list-inside list-disc space-y-0.5 text-xs text-red-700">
        <% errors.forEach(error => { %>
        <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
<% } %>
