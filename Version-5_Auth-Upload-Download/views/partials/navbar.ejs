<nav class="sticky top-0 z-40 border-b border-gray-200 bg-white shadow-sm">
  <div class="mx-auto flex w-11/12 max-w-6xl items-center justify-between py-3.5">
    <!-- Brand Logo (Custom-crafted, original Stay & Home mark) -->
    <a href="/" class="group flex items-center gap-2 text-2xl font-bold text-rose-500 transition hover:text-rose-600">
      <svg class="h-8 w-8 text-rose-500 transition-transform duration-200 group-hover:scale-105" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M16 2.5L3 13.5V26.5C3 27.6 3.9 28.5 5 28.5H27C28.1 28.5 29 27.6 29 26.5V13.5L16 2.5Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M11.5 28.5V17.5C11.5 16.4 12.4 15.5 13.5 15.5H18.5C19.6 15.5 20.5 16.4 20.5 17.5V28.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M16 8C14.9 8 14 8.9 14 10C14 11.5 16 13 16 13C16 13 18 11.5 18 10C18 8.9 17.1 8 16 8Z" fill="currentColor"/>
      </svg>
      <span class="tracking-tight">airbnb</span>
    </a>

    <!-- Center Navigation Links -->
    <div class="hidden items-center gap-1.5 text-sm md:flex">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-medium transition <%= currentPage === 'index' ? 'bg-rose-50 text-rose-600 font-semibold shadow-sm' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900' %>"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Home
      </a>

      <% if (isLoggedIn) { %>
        <% if (user && user.userType === 'guest') { %>
          <a
            href="/houses"
            class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-medium transition <%= currentPage === 'housesList' ? 'bg-rose-50 text-rose-600 font-semibold shadow-sm' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900' %>"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            Houses
          </a>
          <a
            href="/favourites"
            class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-medium transition <%= currentPage === 'favourites' ? 'bg-rose-50 text-rose-600 font-semibold shadow-sm' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900' %>"
          >
            <svg class="h-4 w-4 fill-current text-rose-500" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            Favourites
          </a>
          <a
            href="/bookings"
            class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-medium transition <%= currentPage === 'bookings' ? 'bg-rose-50 text-rose-600 font-semibold shadow-sm' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900' %>"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Bookings
          </a>
        <% } else if (user && user.userType === 'host') { %>
          <a
            href="/host/host-houses-list"
            class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-medium transition <%= currentPage === 'hostHouseList' ? 'bg-rose-50 text-rose-600 font-semibold shadow-sm' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900' %>"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            Host Houses
          </a>
          <a
            href="/host/add-house"
            class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-medium transition <%= currentPage === 'addHouse' ? 'bg-rose-50 text-rose-600 font-semibold shadow-sm' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900' %>"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add House
          </a>
        <% } %>
      <% } %>
    </div>

    <!-- Right Profile / Dropdown Menu -->
    <div class="relative" id="user-menu-container">
      <button
        id="user-menu-button"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        class="flex items-center gap-3 rounded-full border border-gray-300 bg-white py-1.5 pl-3.5 pr-2.5 text-gray-700 shadow-sm transition hover:shadow-md hover:border-gray-400 focus:outline-none cursor-pointer"
      >
        <!-- Hamburger Menu Icon -->
        <svg class="h-4 w-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>

        <!-- User Avatar Circle -->
        <div class="relative flex h-8 w-8 items-center justify-center rounded-full bg-gray-600 text-white font-bold text-xs">
          <% if (isLoggedIn && user && (user.firstName || user.name)) { %>
            <%= (user.firstName || user.name).charAt(0).toUpperCase() %>
            <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-green-500"></span>
          <% } else { %>
            <svg class="h-5 w-5 fill-current text-white" viewBox="0 0 24 24">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
          <% } %>
        </div>
      </button>

      <!-- Dropdown Panel -->
      <div
        id="user-menu-dropdown"
        class="hidden absolute right-0 mt-2 w-64 origin-top-right rounded-2xl border border-gray-100 bg-white py-2 shadow-xl ring-1 ring-black ring-opacity-5 z-50 transition-all duration-150"
      >
        <% if (!isLoggedIn) { %>
          <!-- Not Logged In Options with Icons (No explore house link) -->
          <div class="px-4 py-2 border-b border-gray-100">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Welcome to airbnb</p>
          </div>

          <a
            href="/login"
            class="group flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-gray-800 transition hover:bg-rose-50 hover:text-rose-600"
          >
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-gray-600 group-hover:bg-rose-100 group-hover:text-rose-600 transition">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
              </svg>
            </div>
            <div>
              <span>Log In</span>
              <p class="text-xs font-normal text-gray-400">Access your account</p>
            </div>
          </a>

          <a
            href="/signup"
            class="group flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-gray-800 transition hover:bg-rose-50 hover:text-rose-600"
          >
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-gray-600 group-hover:bg-rose-100 group-hover:text-rose-600 transition">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
              </svg>
            </div>
            <div>
              <span>Sign Up</span>
              <p class="text-xs font-normal text-gray-400">Create a new account</p>
            </div>
          </a>

        <% } else { %>
          <!-- Logged In User Header -->
          <div class="px-4 py-2.5 border-b border-gray-100">
            <p class="text-xs text-gray-400">Signed in as</p>
            <p class="font-bold text-gray-900 truncate"><%= user.firstName || user.name || user.email %></p>
            <span class="inline-block mt-1 rounded-full bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-600 capitalize">
              <%= user.userType || 'Guest' %>
            </span>
          </div>

          <!-- Mobile Quick Links inside Dropdown -->
          <div class="md:hidden border-b border-gray-100 py-1">
            <a
              href="/"
              class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition"
            >
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              Home
            </a>
          </div>

          <% if (user && user.userType === 'guest') { %>
            <a
              href="/houses"
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition"
            >
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              Explore Houses
            </a>
            <a
              href="/favourites"
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition"
            >
              <svg class="h-4 w-4 text-rose-500 fill-current" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              Favourites
            </a>
            <a
              href="/bookings"
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition"
            >
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Bookings
            </a>
          <% } else if (user && user.userType === 'host') { %>
            <a
              href="/host/host-houses-list"
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition"
            >
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              Manage Listings
            </a>
            <a
              href="/host/add-house"
              class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition"
            >
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              Add New House
            </a>
          <% } %>

          <div class="my-1 border-t border-gray-100"></div>

          <form action="/logout" method="POST" class="m-0">
            <button
              type="submit"
              class="flex w-full items-center gap-3 px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50 transition cursor-pointer"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              <span>Log Out</span>
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    const btn = document.getElementById('user-menu-button');
    const dropdown = document.getElementById('user-menu-dropdown');
    if (!btn || !dropdown) return;

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      const isOpen = !dropdown.classList.contains('hidden');
      if (isOpen) {
        dropdown.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        dropdown.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });

    document.addEventListener('click', function (e) {
      if (!dropdown.contains(e.target) && !btn.contains(e.target)) {
        dropdown.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>
