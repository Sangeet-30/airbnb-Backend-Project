<%- include('../partials/head') %>
  </head>
<body class="min-h-screen bg-gray-100 text-gray-800">
  <%- include('../partials/navbar') %>

  <header class="bg-white px-4 py-8 text-center">
    <h1 class="text-3xl font-bold text-red-500">
      <%= editing ? "Edit" : "Register" %> your house here
    </h1>
    <p class="mt-2 text-gray-500">
      <%= editing ? "Update" : "Add" %> the details of your property.
    </p>
  </header>

  <main class="mx-auto w-11/12 max-w-2xl py-10">
    <div class="overflow-hidden rounded-2xl bg-white shadow-lg">
      <div class="border-b border-gray-200 bg-gray-50 px-6 py-5">
        <h2 class="text-xl font-bold text-gray-800">House Details</h2>
        <p class="mt-1 text-sm text-gray-500">
          Enter the information guests need to know.
        </p>
      </div>

      <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
      <div role="alert" class="mx-6 mt-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        <p class="font-semibold mb-1">Please fix the following issues:</p>
        <ul class="list-inside list-disc">
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <form
        action="/host/<%= editing ? 'edit-house' : 'add-house' %>"
        method="POST"
        class="grid gap-5 p-6"
      >
        <input type="hidden" name="id" value="<%= house && house._id ? house._id : '' %>" />

        <div>
          <label for="houseName" class="mb-2 block font-semibold text-gray-700"
            >House Name</label
          >
          <input
            id="houseName"
            type="text"
            name="houseName"
            required
            maxlength="100"
            value="<%= house && house.houseName ? house.houseName : '' %>"
            placeholder="Enter your house name"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
          />
        </div>
        <div>
          <label for="price" class="mb-2 block font-semibold text-gray-700"
            >Price per Night</label
          >
          <input
            id="price"
            type="number"
            name="price"
            min="1"
            step="0.01"
            required
            value="<%= house && house.price ? house.price : '' %>"
            placeholder="Enter price per night"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
          />
        </div>
        <div>
          <label for="location" class="mb-2 block font-semibold text-gray-700"
            >Location</label
          >
          <input
            id="location"
            type="text"
            name="location"
            required
            maxlength="150"
            value="<%= house && house.location ? house.location : '' %>"
            placeholder="Enter house location"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
          />
        </div>
        <div>
          <label for="rating" class="mb-2 block font-semibold text-gray-700"
            >Rating</label
          >
          <input
            id="rating"
            type="number"
            name="rating"
            min="0"
            max="5"
            step="0.1"
            required
            value="<%= house && house.rating !== undefined && house.rating !== null ? house.rating : '' %>"
            placeholder="Enter house rating (0 to 5)"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
          />
        </div>
        <div>
          <label for="photoUrl" class="mb-2 block font-semibold text-gray-700"
            >Photo URL</label
          >
          <input
            id="photoUrl"
            type="url"
            name="photoUrl"
            value="<%= house && house.photoUrl ? house.photoUrl : '' %>"
            placeholder="Enter photo URL (optional)"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
          />
        </div>
        <div>
          <label
            for="description"
            class="mb-2 block font-semibold text-gray-700"
            >Description</label
          >
          <textarea
            id="description"
            name="description"
            maxlength="2000"
            placeholder="Describe your house"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
          ><%= house && house.description ? house.description : '' %></textarea>
        </div>
        <button
          type="submit"
          class="cursor-pointer mt-2 w-full rounded-lg bg-red-500 px-5 py-3 font-semibold text-white hover:bg-red-600"
        >
          <%= editing ? "Update" : "Register" %>
          House
        </button>
      </form>
    </div>
  </main>
</body>

</html>
