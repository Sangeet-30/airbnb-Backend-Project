<%- include('partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-100 text-gray-800">
    <%- include('partials/navbar') %>
    <main
      class="mx-auto mt-16 w-11/12 max-w-lg rounded-xl bg-white p-10 text-center shadow-lg"
    >
      <h1 class="text-5xl font-bold text-red-500">500</h1>
      <p class="mt-3 text-xl font-semibold">Something went wrong</p>
      <p class="mt-2 text-gray-500">
        <%= typeof errorMessage !== 'undefined' && errorMessage ? errorMessage : "An unexpected server error occurred. Please try again later." %>
      </p>
      <a
        href="/"
        class="mt-6 inline-block rounded-lg bg-red-500 px-6 py-3 font-semibold text-white hover:bg-red-600"
        >Go to Home</a
      >
    </main>
  </body>
</html>
