<%- include('../partials/head') %>
  </head>
<body class="min-h-screen bg-gray-100 text-gray-800">
  <%- include('../partials/navbar') %>

  <header class="bg-white px-4 py-8 text-center">
    <h1 class="text-3xl font-bold text-red-500">Login to airbnb</h1>
    <p class="mt-2 text-gray-500">Demo login for learning sessions (no real account verification).</p>
  </header>

  <main class="mx-auto w-11/12 max-w-2xl py-10">
    <div class="overflow-hidden rounded-2xl bg-white shadow-lg">
      <div class="border-b border-gray-200 bg-gray-50 px-6 py-5">
        <h2 class="text-xl font-bold text-gray-800">Login Details</h2>
        <p class="mt-1 text-sm text-gray-500">
          Enter the information to login to airbnb.
        </p>
      </div>

      <form
        action="/login"
        method="POST"
        class="grid gap-5 p-6"
      >

        <div>
          <label for="username" class="mb-2 block font-semibold text-gray-700"
            >Email or Username</label
          >
          <input
            id="username"
            type="text"
            name="username"
            placeholder="Enter your Email or Username"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
            required
          />
        </div>
        <div>
          <label for="password" class="mb-2 block font-semibold text-gray-700"
            >Password</label
          >
          <input
            id="password"
            type="password"
            name="password"
            placeholder="Enter your password"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
            required
          />
        </div>

        <button
          type="submit"
          class="cursor-pointer mt-2 w-full rounded-lg bg-red-500 px-5 py-3 font-semibold text-white hover:bg-red-600"
        >
          Log In
        </button>
      </form>
    </div>
  </main>
</body>

</html>
